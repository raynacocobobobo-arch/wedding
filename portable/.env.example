# Copy to .env and replace ALL placeholders. NEVER commit .env.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD
COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_NOT_THIS
HOST=127.0.0.1
PORT=3000
# Set COOKIE_SECURE=1 behind HTTPS in production; 0 for localhost HTTP.
COOKIE_SECURE=0
# DATA_DIR=/app/data
# When behind a trusted local Nginx/Caddy proxy, set TRUST_PROXY=1 and overwrite X-Real-IP.
TRUST_PROXY=0

# Enterprise WeChat group robot webhook (private; never commit your real URL)
WECOM_WEBHOOK=
# Visible contact information for the public site. Leave blank for "待配置".
CONTACT_PHONE=
CONTACT_WECHAT=
CONTACT_ADDRESS=

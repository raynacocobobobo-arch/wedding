  "principles": [
    {
      "k": "搬家原则",
      "d": "把现场可利用的元素搬进画面：花、喜字、道具挪到合适的位置与光线里，别被现场摆设限制。"
    },
    {
      "k": "镜面原则",
      "d": "善用镜子、玻璃、水面、屏幕等反射面，一个镜头里装下双重信息，画面更高级。"
    },
    {
      "k": "灯光原则",
      "d": "以现场光线为主，用逆光、侧光塑造轮廓；需要时补一灯做造型，避免糊成一片平光。"
    },
    {
      "k": "非常规构图原则",
      "d": "敢于突破三分法与平视，用低角度、遮挡、前景、大留白制造新鲜感。"
    },
    {
      "k": "突出：画面干净",
      "d": "主体突出、背景干净。开拍前先清场，挪走杂物，避开宾客与设备。"
    }
  ]
}
